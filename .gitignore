# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# dbt
target/
dbt_packages/
logs/
*.log
transform/risklens_dbt/profiles.yml
transform/risklens_dbt/*.duckdb

# Terraform
