# Copy this file to .env and fill in real values locally. Never commit .env.

# Warehouse (choose one)
WAREHOUSE_TYPE=snowflake        # snowflake | bigquery
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=risklens_dev
BIGQUERY_PROJECT=
BIGQUERY_KEYFILE_PATH=

# Environment
ENV=dev                          # dev | staging | prod

# Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STREAMING_TOPIC=risklens.loan_events

# Alerting
SLACK_WEBHOOK_URL=
